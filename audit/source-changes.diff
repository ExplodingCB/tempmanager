+            DeleteObject(bitmap as HGDIOBJ);
+            DeleteDC(dc);
+            DestroyWindow(hwnd);
+            eprintln!("200 paints: {elapsed:?}; GDI objects {before} -> {after}");
+            assert_eq!(after, before, "GDI objects grew over repeated paints");
+        }
+    }
+}
